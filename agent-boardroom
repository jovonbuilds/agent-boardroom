#!/usr/bin/env python3
"""Development shim: run agent-boardroom straight from a clone, without installing.

The installed command (pipx/pip) uses the `agent-boardroom` console entry point instead; both
call agent_boardroom.cli.main, so the exit-code contract is identical either way.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))  # the clone root holds the package
from agent_boardroom.cli import main  # noqa: E402

main()
